# Rename this file to ".env" and fill in your real values below.
# NEVER commit the real .env file to GitHub — only this .example version.

# Your MongoDB Atlas connection string (get from MongoDB Atlas dashboard)
MONGO_URI=your_mongodb_connection_string_here

# Your Gemini API key (get free from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Port the backend server will run on
PORT=5000
